<App
  var.serverUrl="http://localhost:3000"
  var.indexName=""
  var.filter=""
  var.sortBy="filepath"
  var.selectedSpec=""
  var.navStack="{[]}"
  var.navPos="{-1}"
  var.wordWrap="{true}">

  <AppHeader title="CodeExam XmlUi Prompt Catalog">
    <property name="profileMenuTemplate">
      <Inspector />
    </property>
  </AppHeader>

  <DataSource
    id="indexesData"
    url="{serverUrl}/api/indexes"
    resultSelector="indexes"
    omitTransactionId="true" />

  <DataSource
    id="promptsData"
    url="{serverUrl}/api/prompts"
    queryParams="{{ index: indexName || undefined }}"
    omitTransactionId="true" />

  <DataSource
    id="sourceData"
    url="{serverUrl}/api/extract-linkified"
    queryParams="{{ index: indexName || undefined, func: selectedSpec }}"
    when="{!!selectedSpec}"
    omitTransactionId="true" />

  <Pages fallbackPath="/">
  <Page url="/">
  <VStack padding="1rem" gap="0.75rem" height="100vh">

    <HStack gap="1rem" verticalAlignment="center">
      <Text>Server:</Text>
      <TextBox
        width="18rem"
        initialValue="{serverUrl}"
        onDidChange="(v) => serverUrl = v" />
      <Text>Index:</Text>
      <Select
        width="18rem"
        placeholder="(server's active index)"
        onDidChange="(v) => indexName = v">
        <Items data="{indexesData.value || []}">
          <Option
            value="{$item.name}"
            label="{$item.name}  ·  {$item.files} files{$item.active ? '  ·  active' : ''}" />
        </Items>
      </Select>
      <Button
        label="Reload"
        onClick="promptsData.refetch()" />
    </HStack>

    <HStack gap="1rem" verticalAlignment="center">
      <Text>Filter:</Text>
      <TextBox
        width="20rem"
        initialValue="{filter}"
        onDidChange="(v) => filter = v"
        placeholder="substring match in text + filepath" />
      <Text>Sort:</Text>
      <Select
        initialValue="filepath"
        onDidChange="(v) => sortBy = v">
        <Option value="filepath" label="Filepath" />
        <Option value="length-desc" label="Length (long first)" />
        <Option value="length-asc" label="Length (short first)" />
        <Option value="alpha" label="Alphabetical (text)" />
      </Select>
      <Text>
        Total: {(promptsData.value &amp;&amp; promptsData.value.total) || 0}
      </Text>
    </HStack>

    <HSplitter height="70vh" initialPrimarySize="55%">

      <!-- LEFT: prompt list -->
      <VStack padding="0.5rem" gap="0.5rem">

        <Text when="{promptsData.inProgress}">Loading…</Text>
        <Text when="{promptsData.error}">Error — check server URL and index.</Text>

        <List
          when="{promptsData.loaded}"
          data="{
            ((promptsData.value &amp;&amp; promptsData.value.prompts) || [])
              .filter(p =&gt; !filter ||
                (p.text + ' ' + p.filepath).toLowerCase().includes(filter.toLowerCase()))
              .slice()
              .sort((a, b) =&gt;
                sortBy === 'length-desc' ? b.text.length - a.text.length :
                sortBy === 'length-asc'  ? a.text.length - b.text.length :
                sortBy === 'alpha'       ? a.text.localeCompare(b.text) :
                (a.filepath.localeCompare(b.filepath) || a.lineNum - b.lineNum))
          }">
          <Card>
            <VStack gap="0.25rem">
              <HStack gap="1rem" verticalAlignment="center">
                <Text variant="strong">{$item.filepath}:L{$item.lineNum}</Text>
                <Text variant="secondary">[{$item.type}]</Text>
                <Text variant="secondary">{$item.text.length} chars</Text>
              </HStack>
              <HStack gap="0.5rem" verticalAlignment="center">
                <Text variant="secondary">Function:</Text>
                <Link
                  when="{!!$item.func}"
                  label="{$item.funcDisplay || $item.func}"
                  onClick="{
                    const s = $item.filepath + '@' + ($item.funcDisplay || $item.func);
                    navStack = [...navStack.slice(0, navPos + 1), s];
                    navPos = navStack.length - 1;
                    selectedSpec = s;
                  }" />
                <Text when="{!$item.func}" variant="secondary">(file scope)</Text>
                <Text when="{!!$item.varName}" variant="secondary">
                  · Variable: {$item.varName}
                </Text>
              </HStack>
              <Text preserveLinebreaks="true" style="{{ fontFamily: 'monospace', whiteSpace: 'pre-wrap' }}">
                {$item.text}
              </Text>
            </VStack>
          </Card>
        </List>
      </VStack>

      <!-- RIGHT: source pane -->
      <VStack padding="0.5rem" gap="0.5rem">

        <!-- back/forward nav bar -->
        <HStack gap="0.5rem" verticalAlignment="center">
          <Button
            label="←"
            enabled="{navPos > 0}"
            onClick="{
              navPos = navPos - 1;
              selectedSpec = navStack[navPos];
            }" />
          <Button
            label="→"
            enabled="{navPos &lt; navStack.length - 1}"
            onClick="{
              navPos = navPos + 1;
              selectedSpec = navStack[navPos];
            }" />
          <Text variant="secondary">
            {navStack.length === 0 ? '(nothing selected)' : (navPos + 1) + ' of ' + navStack.length}
          </Text>
          <Switch
            label="Word wrap"
            initialValue="{wordWrap}"
            onDidChange="(v) => wordWrap = v" />
        </HStack>

        <Text when="{!selectedSpec}" variant="secondary">
          Click a function name on the left to view source.
        </Text>
        <Text when="{!!selectedSpec &amp;&amp; sourceData.inProgress}">Loading source…</Text>
        <Text when="{!!selectedSpec &amp;&amp; sourceData.error}" variant="secondary">
          Error loading source (function may be ambiguous or not indexed).
        </Text>

        <VStack when="{!!selectedSpec &amp;&amp; sourceData.loaded &amp;&amp; sourceData.value &amp;&amp; sourceData.value.lines}" gap="0.25rem">
          <Text variant="strong">{sourceData.value.display_name}</Text>
          <Text variant="secondary">
            {sourceData.value.filepath}:L{sourceData.value.start_line} ({sourceData.value.line_count} lines)
          </Text>

          <!-- source rendered one line per <List> row.
               Step 1: outer <Items> → <List fixedItemSize="true"> for
               line-level virtualization (the prototype's original perf wall).
               Step 2 (pragmatic, not full wrapComponent): inner per-segment
               <Items> + <Link>/<Text> replaced with a single <Text> per line
               containing the joined segment text. Each visible line is one
               DOM element instead of N segment components — fixes both the
               indent-collapse (XMLUI Text+flex was dropping leading whitespace)
               and gives the virtualizer uniform row heights.
               Trade-off: clickable identifiers WITHIN rendered source are
               lost in this pragmatic version. Left-pane prompt clicks and
               back/forward nav still work. Full wrapComponent + delegated
               click handlers (per Jon's Q3 answer) recovers in-source clicks
               while keeping these wins; deferred to Thursday meeting.
               Caveat: fixedItemSize="true" assumes uniform line height — true
               when wordWrap is off. Toggle wordWrap off for clean perf test. -->
          <VStack gap="0" style="{{ fontFamily: 'monospace' }}" height="60vh">
            <List data="{sourceData.value.lines}" fixedItemSize="true">
              <Text style="{{ whiteSpace: wordWrap ? 'pre-wrap' : 'pre', fontFamily: 'monospace' }}">
                {$item.segments.map(s => s.text).join('') || ' '}
              </Text>
            </List>
          </VStack>
        </VStack>

        <VStack when="{!!selectedSpec &amp;&amp; sourceData.loaded &amp;&amp; sourceData.value &amp;&amp; sourceData.value.ambiguous}" gap="0.25rem">
          <Text variant="strong">Ambiguous — pick one:</Text>
          <List data="{sourceData.value.matches}">
            <Link
              label="{$item.display_name} — {$item.filepath}:L{$item.start} ({$item.lines} lines)"
              onClick="{
              const s = $item.filepath + '@' + $item.name;
              navStack = [...navStack.slice(0, navPos + 1), s];
              navPos = navStack.length - 1;
              selectedSpec = s;
            }" />
          </List>
        </VStack>

      </VStack>

    </HSplitter>

  </VStack>
  </Page>
  </Pages>
</App>
