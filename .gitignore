# ── CodeExam .gitignore ───────────────────────────────────────────────
# Guards the repo tree. Scratch and dev/agent files live on disk but never
# get committed. This works going forward; for files already tracked, the
# untrack-* worklist items do `git rm --cached`.

# Dependencies & build artifacts
node_modules/
dist/
__pycache__/
*.log

# Built indexes — CE creates dot-directories holding literal_index.json.
# Ignore ALL root dot-directories (catches .demo/, .CC_cli_js/, … and the
# dev .claude/); keep .github/. Build indexes outside the repo or under
# _scratch/.
/.*/
!/.github/

# Dev / agent infra (Bram + Claude Code) — not part of the public product
resources/
CLAUDE.md
_scratch/

# Secrets — never commit
claude*.txt
*.key
*.pem
.env

# OS / editor cruft
.DS_Store
Thumbs.db

# One-off non-product directories (removed via untrack-nonblessed-dirs)
files/
claude-skills/
xmlui-prompt-catalog/

# Loose root scratch: notes, transcripts, screenshots, dead duplicates,
# file-lists. Anchored to the repo root, so subdirs (src/, test/, docs/, …)
# are unaffected. Standard community files are kept.
/*.txt
/*.jpg
/*.png
/*.lst
/*.py
/*.js
/*.html
/*.css
/*.md
!/README.md
!/CONTRIBUTING.md
!/CODE_OF_CONDUCT.md
!/SECURITY.md
