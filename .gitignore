# ── CodeExam .gitignore ───────────────────────────────────────────────
# Public-repo guard. The blessed surface is small, so DIRECTORIES use an
# allowlist (ignore all root dirs, re-include the few we ship) and FILES use
# a denylist. Scratch / dev / binaries live on disk but never get committed.

# ── Directories: allowlist ────────────────────────────────────────────
# Ignore every root directory — index dot-dirs (.demo/, .CC_cli_js/), dev
# infra (.claude/, resources/), build dirs (node_modules/, dist/), and all
# extracted-source / book-corpus dirs (cli_js/, opencode.extracted/,
# manning_books/, react/, whisper.cpp/, …) — then re-include only the blessed.
/*/
!/.github/
!/src/
!/public/
!/grammars/
!/test/
!/scripts/
!/docs/
!/samples/

# Re-ignore build/dep dirs even if nested inside a blessed dir
node_modules/
__pycache__/
dist/

# ── Dev / agent infra (not part of the public product) ────────────────
CLAUDE.md

# ── Secrets — never commit ────────────────────────────────────────────
claude*.txt
*.key
*.pem
.env

# ── Large binaries / archives / captures / documents (untracked scratch)
# .har captures can hold session cookies/tokens — ignored first.
*.har
*.saz
*.gguf
*.exe
*.dll
*.tar
*.gz
*.tgz
*.7z
*.zip
!/samples/*.zip
!/FIRST_RUN_INDEX.zip
*.pdf
*.docx
*.doc
*.pptx
*.xlsx
*.db
*.diff
*.fp.json

# ── OS / editor cruft ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log

# ── Loose root scratch (root-anchored so blessed subdirs are unaffected)
/*.txt
/*.jpg
/*.png
/*.lst
/*.py
/*.js
/*.html
/*.css
/*.md
!/README.md
!/CONTRIBUTING.md
!/CODE_OF_CONDUCT.md
!/SECURITY.md
!/AIR_GAPPED.md
!/TOUR.md
# Blessed docs split out of README.md (#274); names/location may move to docs/
!/GETTING_STARTED.md
!/CODEEXAM_GUI.md
!/CODEEXAM_CLI.md
!/CODEEXAM_MCP.md
!/LOCAL_LLM.md
!/UNCOVER_KEY_CODE.md
!/QUASI_SOURCE.md
!/DETECTING_AI_ML.md
!/STRUCTURAL_SEARCH.md
!/CODEEXAM_KEY_FEATURES.md
!/AI_ASSISTED_CODE_EXAM.md
!/CODEEXAM_INDEXES.md
!/CODEEXAM_ARCHITECTURE.md
!/CODEEXAM_TESTING.md
!/CODEEXAM_KNOWN_LIMITATIONS.md
!/CODEEXAM_CODECLAIM_PATENT_ANALYSIS.md
# Screenshots referenced from README.md / CODEEXAM_GUI.md (may move to imgs/)
!/prompts_from_cli_js_from_claude_exe.jpg
!/CodeExam_file_map_042526.jpg

# Stray scratch extensions anywhere (also sweeps src/service.xxx).
# gitignore matching is case-sensitive here, so include upper-case outliers.
*.awk
*.AWK
*.ps1
*.tst
*.xxx
*.tmp
